rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────────

    // Check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check for Admin role safely
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.get('admin', false) == true;
    }

    // Check for Doctor role safely
    // 1. Checks custom claims (role == 'doctor' or admin == true)
    // 2. Fallback: checks the UserProfiles document for the requester
    function isDoctor() {
      return isAuthenticated() && (
        request.auth.token.get('role', 'user') == 'doctor' ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/UserProfiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/UserProfiles/$(request.auth.uid)).data.userType == 'doctor')
      );
    }

    // Check if a field is being modified
    function isUnchanged(key) {
      return !(key in request.resource.data) || request.resource.data[key] == resource.data[key];
    }

    // ─── USER PROFILES COLLECTION ──────────────────────────────────
    match /UserProfiles/{userId} {
      // Users can read their own profile. Doctors/Admins can read any profile.
      allow read: if isOwner(userId) || isDoctor();

      // Anyone authenticated can create their own document
      // We allow both 'user' and 'doctor' types for initial creation
      allow create: if isOwner(userId)
        && (request.resource.data.userType == 'user' || request.resource.data.userType == 'doctor');

      // Users can update their own profile, but cannot change sensitive fields
      allow update: if (isOwner(userId)
        && isUnchanged('userType')
        && isUnchanged('email')
        && isUnchanged('userId')) || isAdmin();

      // ─── USER ACTIVITIES SUB-COLLECTION ──────────────────────────
      match /activities/{activityId} {
        allow read, write: if isOwner(userId) || isDoctor();
      }
    }

    // ─── DOCTORS COLLECTION ────────────────────────────────────────
    match /doctors/{doctorId} {
      // Authenticated users can read doctor profiles for discovery
      allow read: if isAuthenticated();

      // Only admins can create/update/delete doctor profiles
      allow write: if isAdmin();
    }

    // ─── APPOINTMENTS COLLECTION ───────────────────────────────────
    match /appointments/{appointmentId} {
      // Only the patient or doctor involved can read appointment data
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.doctorId ||
        isAdmin()
      );

      // Authenticated users can create appointments for themselves
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Upcoming';

      // Allow updates to status by the owner or doctor, but prevent hijacking
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.doctorId
      ) && isUnchanged('userId') && isUnchanged('doctorId');
    }

    // ─── REVIEWS COLLECTION ────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public

      // Only authenticated users can create reviews for themselves
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      // Only the author can edit or delete their review
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ─── CHAT SYSTEM ───────────────────────────────────────────────
    match /chatRooms/{roomId} {
      // 'get' allows fetching a single room document by its exact ID
      allow get: if isAuthenticated();

      // 'list' / queries: allow if user is authenticated
      // (or scope it tightly to rooms where they are a participant)
      allow list: if isAuthenticated();

      // Allow creating or updating the room if authenticated
      allow create, update: if isAuthenticated() &&
      (request.resource.data.participants is list);

      match /messages/{messageId} {
        // Only participants can read messages
        allow read: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;

        // Only participants can send messages, and cannot edit/delete
        allow create: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
        && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if false;
      }
    }
  }
}
